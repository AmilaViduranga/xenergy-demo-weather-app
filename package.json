{
  "name": "demo-weather-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "inject-key": "node scripts/inject-openweather-key.js",
    "prestart": "npm run inject-key",
    "start": "ng serve",
    "prebuild": "npm run inject-key",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run inject-key",
    "test": "ng test",
    "pretest:ci": "npm run inject-key",
    "test:ci": "ng test --no-watch --browsers=ChromeHeadlessCI --code-coverage",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium ffmpeg",
    "e2e:ui": "playwright test --ui",
    "perf": "npm run build && lhci autorun",
    "ci": "npm run lint && npm run test:ci && npm run e2e && npm run perf"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "chart.js": "^4.5.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.6",
    "@angular/cli": "^19.0.6",
    "@angular/compiler-cli": "^19.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "19.8.1",
    "eslint": "^9.28.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "8.33.1"
  }
}
